 
import matplotlib.pyplot as plt 
from sklearn.datasets import load_iris 
from sklearn.cluster import KMeans 
iris = load_iris() 
X = iris.data 
print("Iris Dataset:") 
print(X) 
 
kmeans = KMeans( 
    n_clusters=3, 
    random_state=42, 
    n_init=10 
) 
clusters = kmeans.fit_predict(X) 
 
centroids = kmeans.cluster_centers_ 
 
print("\nCluster Labels:") 
print(clusters) 
 
print("\nCluster Centroids:") 
print(centroids) 
 
 
plt.figure(figsize=(8, 6)) 
 
plt.scatter( 
    X[clusters == 0, 0], 
    X[clusters == 0, 1], 
    c="red", 
    label="Cluster 1" 
) 
 
plt.scatter( 
    X[clusters == 1, 0], 
    X[clusters == 1, 1], 
    c="blue", 
    label="Cluster 2" 
) 
 
plt.scatter( 
    X[clusters == 2, 0], 
    X[clusters == 2, 1], 
    c="green", 
    label="Cluster 3" 
) 
plt.scatter( 
    centroids[:, 0], 
    centroids[:, 1], 
    c="black", 
    marker="X", 
    s=200, 
    label="Centroids" 
) 
 
plt.xlabel("Sepal Length (cm)") 
plt.ylabel("Sepal Width (cm)") 
plt.title("K-Means Clustering of Iris Dataset (K=3)") 
plt.legend() 
plt.grid(True) 
plt.show() 